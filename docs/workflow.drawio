<mxfile host="app.diagrams.net">
  <diagram name="Resume workflow" id="resume-workflow">
    <mxGraphModel dx="1600" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="portals" value="&lt;b&gt;Job portals&lt;/b&gt;&lt;br&gt;postings" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#FAFBFC;strokeColor=#B9C0C9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="quest" value="&lt;b&gt;1 QUEST&lt;/b&gt;&lt;br&gt;&lt;b&gt;Find the job description&lt;/b&gt;&lt;br&gt;Today: search the portals by hand, copy the JD&lt;br&gt;&lt;i&gt;Next: a quest agent scours the web for suitable postings&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F6E54;strokeWidth=2;fontColor=#262626;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="160" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="trainer" value="&lt;b&gt;2 TRAINER&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fit analysis and tailored resume&lt;/b&gt;&lt;br&gt;Today: an LLM reads the JD against the evidence&lt;br&gt;&lt;i&gt;Next: a trainer agent that fits and tailors&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8F6E54;strokeWidth=2;fontColor=#262626;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="resume_prompt_instruction.md&lt;br&gt;system prompt" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#E6F2F6;strokeColor=#177A9A;fontColor=#177A9A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="30" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="master_resume_repository.md&lt;br&gt;career experience, evidence units" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#E6F2F6;strokeColor=#177A9A;fontColor=#177A9A;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="30" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dresser" value="&lt;b&gt;3 DRESSER (this tool)&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tidy up the resume&lt;/b&gt;&lt;br&gt;Today: Resume Render, Markdown to .docx / PDF&lt;br&gt;&lt;i&gt;Next: a dresser agent that preps the application and the interview&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F2F6;strokeColor=#177A9A;strokeWidth=3;fontColor=#262626;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="160" width="270" height="120" as="geometry" />
        </mxCell>
        <mxCell id="apply" value="&lt;b&gt;Apply&lt;/b&gt;&lt;br&gt;then interview" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#FAFBFC;strokeColor=#B9C0C9;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="1410" y="190" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="posting" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#177A9A;strokeWidth=2;fontColor=#177A9A;flowAnimation=1;" edge="1" parent="1" source="portals" target="quest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="JD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#177A9A;strokeWidth=2;fontColor=#177A9A;flowAnimation=1;" edge="1" parent="1" source="quest" target="trainer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="resume.md" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#177A9A;strokeWidth=2;fontColor=#177A9A;flowAnimation=1;" edge="1" parent="1" source="trainer" target="dresser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value=".docx / PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#177A9A;strokeWidth=2;fontColor=#177A9A;flowAnimation=1;" edge="1" parent="1" source="dresser" target="apply">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="rounded=0;html=1;strokeColor=#8F6E54;dashed=1;flowAnimation=1;" edge="1" parent="1" source="prompt" target="trainer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="rounded=0;html=1;strokeColor=#8F6E54;dashed=1;flowAnimation=1;" edge="1" parent="1" source="repo" target="trainer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
